# Shape 03, downstream GPU cluster. Shape values only: region and project live
# in clusters/common-evroc.tfvars (optional); credentials come from `evroc login`.

# Drives hostnames and labels. Must differ from the management cluster's name.
cluster_name = "aif-gpu"

# HA control plane. No rancher: this cluster is imported into the management
# Rancher. cert-manager is listed so workloads can request certificates.
control_plane_count = 3
components          = ["cert-manager", "gpu-operator", "local-path-provisioner"]

# One L40S GPU VM. GPU VMs run in zone "a" only: an unpinned pool uses
# zones[0], so keep "a" first in zones (the default). Nodes: aif-gpu-gpu-NN.
gpu_pools = {
  gpu = { instance_type = "gn-l40s.s", count = 1 }
}

# Optional. Needs a wildcard A record *.<domain> to this cluster's API VIP.
# ingress_domain = "gpu.aif.example.com"
