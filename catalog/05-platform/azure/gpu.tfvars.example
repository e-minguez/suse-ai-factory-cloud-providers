# Shape 05, GPU cluster. Shape values only: credentials, region, admin_cidrs and
# the shared tokens live in clusters/common-all.tfvars and clusters/common-azure.tfvars.
# The Observability CA comes from clusters/gpu/addons.auto.tfvars.json (README, step 4).

# Drives hostnames and labels. Must differ on every cluster.
cluster_name = "aif-gpu"

# HA control plane and one GPU pool. No rancher: this cluster is imported into
# the Rancher on mgmt (register, README step 6).
control_plane_count = 3
components = [
  "cert-manager",
  "gpu-operator",
  "local-path-provisioner",
  "security-downstream",
  "observability-agent",
]

# GPU VM size (one T4). Needs 4 vCPUs of the NCASv3_T4 family quota. Larger options:
# Standard_NV36ads_A10_v5 (A10), Standard_NC24ads_A100_v4 (A100), Standard_NC40ads_H100_v5 (H100).
# Nodes get hostnames aif-gpu-gpu-NN and have no public IP.
gpu_pools = {
  gpu = { instance_type = "Standard_NC4as_T4_v3", count = 1 }
}

# Shape choice, same as on the other clusters: the NeuVector federation endpoint
# becomes fed-neuvector.gpu.aif.example.com, and the primary on sec connects to
# it. Nothing needs this name before gpu is deployed, but a fixed name keeps the
# DNS records alike.
# Create the record "*.gpu.aif.example.com  A  <ingress IP of this cluster>"
# (README, step 3).
ingress_domain = "gpu.aif.example.com"

# Remote SUSE Observability server (cluster obs). The CA is in addons.auto.tfvars.json.
observability_server_url = "https://obs.o11y.aif.example.com"

# NeuVector federation primary (cluster sec): host, port 443 by default.
security_primary_endpoint = "fed-neuvector.sec.aif.example.com"
