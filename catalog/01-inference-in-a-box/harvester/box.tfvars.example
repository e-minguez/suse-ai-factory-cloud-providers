# Shape 01, inference in a box. Shared values (region, admin_cidrs, password
# hashes, ssh keys, aif_release) go in clusters/common-*.tfvars; the Harvester
# kubeconfig, namespace and network go in clusters/common-harvester.tfvars.

cluster_name = "aif-box"

# Rancher, AI Factory and the GPU stack on one node. Changing components
# rebuilds the image and replaces the node.
components = ["rancher", "gpu-operator", "local-path-provisioner", "aif-operator"]

# One node that is control plane. No gpu_pools, no worker_pools.
control_plane_count = 1

# 30 vCPU / 240 GiB with one passthrough GPU (key "cp" = control planes).
# Passthrough pins all guest memory on the host: size it to the free host
# memory (16x40 ran on a 64 GiB host).
control_plane_instance_type = "30x240"
gpu_devices = {
  cp = { device_name = "nvidia.com/GA102GL_A10", count = 1 }
}

# Static VIPs for the Kubernetes API and ingress: inside vpc_cidr, outside the
# DHCP range, not used by any other VM.
api_vip     = "10.114.128.40"
ingress_vip = "10.114.128.41"

# Optional. Default is sslip.io names of the ingress VIP.
# ingress_domain = "aif.example.com"  # A record: *.<domain> -> ingress_vip
