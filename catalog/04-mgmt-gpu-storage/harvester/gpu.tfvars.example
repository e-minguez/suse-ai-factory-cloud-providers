# Shape 04, GPU downstream cluster with storage. Shared values go in clusters/common-*.tfvars;
# the Harvester kubeconfig, namespace and network go in clusters/common-harvester.tfvars.

cluster_name        = "aif-gpu"
control_plane_count = 3
components          = ["cert-manager", "gpu-operator", "suse-storage"]

# Static VIPs for the Kubernetes API and ingress: inside vpc_cidr, outside the
# DHCP range, not used by any other VM or cluster.
api_vip     = "10.114.128.42"
ingress_vip = "10.114.128.43"

suse_storage_nodes = ["storage"]

gpu_pools = {
  gpu = { instance_type = "30x240", count = 1 }
}

# One passthrough GPU per GPU node. The name is the KubeVirt device resource.
gpu_devices = {
  gpu = { device_name = "nvidia.com/GA102GL_A10", count = 1 }
}

worker_pools = {
  storage = { instance_type = "8x16", count = 3 }
  wrk     = { instance_type = "8x16", count = 2 }
}
