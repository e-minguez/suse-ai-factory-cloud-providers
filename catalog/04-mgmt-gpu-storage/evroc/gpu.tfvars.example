# Shape 04, downstream cluster with GPU, storage and general worker pools.
# Shape values only: region and project live in clusters/common-evroc.tfvars
# (optional); credentials come from `evroc login`.

# Drives hostnames and labels. Must differ from the management cluster's name.
cluster_name = "aif-gpu"

# HA control plane. No rancher: this cluster is imported into the management
# Rancher. suse-storage replaces local-path-provisioner: listing both fails
# plan, because both set the default StorageClass.
control_plane_count = 3
components          = ["cert-manager", "gpu-operator", "suse-storage"]

# Longhorn disks only on the storage pool (at least 3 nodes).
suse_storage_nodes = ["storage"]

# One L40S GPU VM. GPU VMs run in zone "a" only: an unpinned pool uses
# zones[0], so keep "a" first in zones (the default).
gpu_pools = {
  gpu = { instance_type = "gn-l40s.s", count = 1 }
}

worker_pools = {
  # Longhorn capacity is the disk size, not the profile. "spread" puts each
  # node on a separate host. All three nodes are in zone a (zones[0]).
  storage = { instance_type = "a1a.m", count = 3, disk_size_gb = 500, placement = "spread" }
  # General workloads.
  wrk = { instance_type = "a1a.m", count = 2 }
}

# Optional. Needs a wildcard A record *.<domain> to this cluster's API VIP.
# ingress_domain = "gpu.aif.example.com"
