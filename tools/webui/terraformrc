# Providers come only from the image (terraform and tofu providers mirror in the Dockerfile, after
# `get`, so every module requirement is included). Terraform's mirror lives under registry.terraform.io
# and OpenTofu's under registry.opentofu.org in the same directory, so both tools read this file.
# No direct registry access at run time.
provider_installation {
  filesystem_mirror {
    path = "/usr/share/terraform/plugins"
  }
}
