#!/usr/bin/env bash
# Finds evroc objects that exist in the project but are missing from this directory's state,
# and writes an import block for each. Run it in a cluster directory (examples/evroc).
#
#   tools/orphans/evroc [--adopt] [-- <terraform plan args>]
#
# Exit: 0 none found (or adopted), 1 found (proposal written), 2 usage, 3 inconclusive.
# Default writes orphan-imports.tf.proposed; --adopt writes imports.tf, which Terraform loads
# on the next plan. Delete imports.tf once an apply has succeeded.
set -euo pipefail

adopt=0
plan_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --adopt) adopt=1 ;;
    -h | --help)
      sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    --)
      shift
      plan_args=("$@")
      break
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      exit 2
      ;;
  esac
  shift
done

for c in terraform jq; do
  command -v "$c" >/dev/null 2>&1 || {
    echo "error: $c not found" >&2
    exit 2
  }
done
[ -d .terraform ] || {
  echo "error: run from an initialised Terraform directory (no .terraform/)" >&2
  exit 2
}

# Same layering as scripts/lib/deploy-common.sh, lowest precedence first.
var_files=()
for f in ../../common-all.tfvars ../common-all.tfvars ../common-evroc.tfvars terraform.tfvars; do
  [ -f "$f" ] && var_files+=("-var-file=$f")
done

# The saved plan and its JSON hold secrets: keep them in a private temp dir, removed on exit.
work=$(mktemp -d "${TMPDIR:-/tmp}/evroc-orphans.XXXXXX")
trap 'rm -rf "$work"' EXIT

echo "==> planning (no refresh) to list what an apply would create"
if ! terraform plan -input=false -no-color -refresh=false -out="$work/plan.bin" \
  ${var_files[@]+"${var_files[@]}"} ${plan_args[@]+"${plan_args[@]}"} >"$work/plan.log" 2>&1 ||
  ! terraform show -json "$work/plan.bin" >"$work/plan.json" 2>>"$work/plan.log" ||
  ! terraform providers schema -json >"$work/schema.json" 2>>"$work/plan.log"; then
  echo "inconclusive: planning failed. Last lines of the plan output:" >&2
  tail -n 15 "$work/plan.log" >&2
  exit 3
fi

# One data lookup per planned create whose type has a data source. spans maps each block's
# line range back to the resource, because diagnostics only carry line numbers.
mkdir "$work/root"
jq -n --slurpfile schema "$work/schema.json" --slurpfile plan "$work/plan.json" '
  ([$schema[0].provider_schemas // {} | to_entries[] | select(.key | endswith("/evroc"))
    | .value.data_source_schemas // {} | to_entries[]
    | {key, value: (.value.block.attributes // {})}] | from_entries) as $ds
  | [$plan[0].resource_changes[]?
     | select(.mode == "managed" and .change.actions == ["create"] and $ds[.type] != null
              and ((.change.after.name | type) == "string"))] as $rcs
  | reduce ($rcs | to_entries[]) as $e (
      {lines: ["terraform {", "  required_providers {",
               "    evroc = { source = \"evroc-oss/evroc\" }", "  }", "}", "provider \"evroc\" {}"],
       spans: []};
      ($e.value.change.after) as $a | $ds[$e.value.type] as $attrs
      | ([("data \"" + $e.value.type + "\" \"p" + ($e.key | tostring) + "\" {"),
          ("  name = " + ($a.name | tojson))]
         + [("project", "region") | select($attrs[.] != null and (($a[.] | type) == "string"))
            | ("  " + . + " = " + ($a[.] | tojson))]
         + ["}"]) as $blk
      | .spans += [{start: ((.lines | length) + 1), end: ((.lines | length) + ($blk | length)),
                    addr: $e.value.address, name: $a.name}]
      | .lines += $blk)
  | {tf: (.lines | join("\n") + "\n"), spans}' >"$work/gen.json"
jq -r .tf "$work/gen.json" >"$work/root/main.tf"
jq .spans "$work/gen.json" >"$work/spans.json"

if [ "$(jq length "$work/spans.json")" -eq 0 ]; then
  echo "none: nothing to create."
  exit 0
fi

# The provider already installed here, pinned by the same lock file: no download.
cp .terraform.lock.hcl "$work/root/"
if ! terraform -chdir="$work/root" init -input=false -no-color -plugin-dir="$PWD/.terraform/providers" \
  >>"$work/plan.log" 2>&1; then
  echo "inconclusive: could not initialise the lookup module." >&2
  exit 3
fi
# Fails whenever a lookup 404s, i.e. almost always: the diagnostics are the result.
terraform -chdir="$work/root" plan -input=false -json >"$work/lookup.jsonl" 2>>"$work/plan.log" || true

# A 404 on a lookup means the name is free; any other error makes the result inconclusive.
result=$(jq -R -n --slurpfile spans "$work/spans.json" '
  ($spans[0]) as $s
  | [inputs | fromjson? | select(type == "object" and .type == "diagnostic") | .diagnostic
     | select(.severity == "error")] as $d
  | reduce $d[] as $x ({missing: [], unsure: false};
      ($x.range.start.line // -1) as $l
      | ([$s[] | select(.start <= $l and $l <= .end)] | first) as $hit
      | if $hit != null and ((($x.summary // "") + " " + ($x.detail // "")) | contains("API error (404)"))
        then .missing += [$hit.addr] else .unsure = true end)
  | . as $r
  | if $r.unsure then {unsure: true, orphans: []}
    else {unsure: false,
          orphans: [$s[] | select(.addr as $a | ($r.missing | any(. == $a)) | not)]} end' \
  <"$work/lookup.jsonl") || result=""

if [ -z "$result" ] || [ "$(jq -r .unsure <<<"$result")" = true ]; then
  echo "inconclusive: some lookups failed for a reason other than 'not found'." >&2
  exit 3
fi
if [ "$(jq '.orphans | length' <<<"$result")" -eq 0 ]; then
  echo "none: nothing this apply would create exists in the project."
  exit 0
fi

out=orphan-imports.tf.proposed
[ "$adopt" -eq 0 ] || out=imports.tf
{
  echo "# Written by tools/orphans/evroc. Delete once an apply has succeeded."
  jq -r '.orphans[] | "\nimport {\n  to = \(.addr)\n  id = \(.name | tojson)\n}"' <<<"$result"
} >"$out"

echo "found: these objects exist in the project but not in this directory's state:"
jq -r '.orphans[] | "  \(.addr)  \(.name)"' <<<"$result"
if [ "$adopt" -eq 1 ]; then
  echo "wrote $out (import blocks); the next plan imports them."
  exit 0
fi
echo "wrote $out. To adopt: review it, rename it to imports.tf, run terraform plan"
echo "(expect only imports), apply, then delete imports.tf. Or use another cluster_name"
echo "if they belong to another deployment."
exit 1
