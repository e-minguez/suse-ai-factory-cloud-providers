run "load_balancers" {
  command = plan

  assert {
    condition = join(",", sort(keys(google_compute_forwarding_rule.this))) == join(",", [
      "ext-http", "ext-https", "ext-kube-api", "int-kube-api", "int-supervisor",
    ])
    error_message = "External: API, http, https. Internal: API and supervisor."
  }

  assert {
    condition = (
      google_compute_forwarding_rule.this["ext-kube-api"].load_balancing_scheme == "EXTERNAL" &&
      google_compute_forwarding_rule.this["ext-kube-api"].ip_address == "203.0.113.10" &&
      google_compute_forwarding_rule.this["ext-https"].ip_address == "203.0.113.10" &&
      google_compute_forwarding_rule.this["int-supervisor"].load_balancing_scheme == "INTERNAL" &&
      google_compute_forwarding_rule.this["int-supervisor"].ip_address == "10.20.0.100" &&
      join(",", google_compute_forwarding_rule.this["int-supervisor"].ports) == "9345" &&
      join(",", google_compute_forwarding_rule.this["ext-http"].ports) == "80" &&
      alltrue([for k, r in google_compute_forwarding_rule.this : r.ip_protocol == "TCP"])
    )
    error_message = "Listeners map to the right address, scheme and port."
  }

  assert {
    condition = (
      google_compute_address.internal_lb.purpose == "SHARED_LOADBALANCER_VIP" && google_compute_address.internal_lb.address_type == "INTERNAL" &&
      google_compute_address.external_lb.address_type == "EXTERNAL"
    )
    error_message = "The internal address is shared by the forwarding rules."
  }

  assert {
    condition = (
      join(",", sort(keys(google_compute_instance_group.control_plane))) == "europe-west4-a,europe-west4-b,europe-west4-c" &&
      alltrue([for k, b in google_compute_region_backend_service.this : b.protocol == "TCP" && b.connection_draining_timeout_sec == 0 && b.load_balancing_scheme == (startswith(k, "ext-") ? "EXTERNAL" : "INTERNAL")])
    )
    error_message = "One instance group per zone with control planes; passthrough TCP backend services."
  }

  assert {
    condition = (
      join(",", sort(keys(google_compute_instance_group_membership.control_plane))) == "gcp-test-cp-01,gcp-test-cp-02,gcp-test-cp-03" &&
      alltrue([for h, m in google_compute_instance_group_membership.control_plane : m.zone == google_compute_instance.control_plane[h].zone && m.instance_group == google_compute_instance_group.control_plane[m.zone].name])
    )
    error_message = "One group membership per control plane, in the group of its zone."
  }

  assert {
    condition = (
      google_compute_region_health_check.this["ext-http"].http_health_check[0].port == 8080 &&
      google_compute_region_health_check.this["ext-http"].http_health_check[0].request_path == "/ping" &&
      google_compute_region_health_check.this["ext-kube-api"].tcp_health_check[0].port == 6443 &&
      google_compute_region_health_check.this["int-supervisor"].tcp_health_check[0].port == 9345
    )
    error_message = "TCP checks for the API ports, the Traefik ping for ingress."
  }
}

