run "firewall_rules" {
  command = plan

  assert {
    condition = join(",", sort(keys(google_compute_firewall.this))) == join(",", [
      "cluster-nodes", "control-plane-api", "control-plane-etcd", "jumphost-ssh", "lb-api", "lb-health", "lb-ingress", "nodes-ssh",
    ])
    error_message = "Rule set changed."
  }

  assert {
    condition = (
      google_compute_firewall.this["jumphost-ssh"].source_ranges == toset(["198.51.100.0/24"]) &&
      google_compute_firewall.this["jumphost-ssh"].target_tags == toset(["gcp-test-jumphost"]) &&
      google_compute_firewall.this["nodes-ssh"].source_tags == toset(["gcp-test-jumphost"]) &&
      google_compute_firewall.this["nodes-ssh"].target_tags == toset(["gcp-test-control-plane", "gcp-test-agent"])
    )
    error_message = "SSH reaches the jumphost from admin_cidrs and nodes from the jumphost only."
  }

  assert {
    condition = (
      contains(google_compute_firewall.this["lb-api"].source_ranges, "198.51.100.0/24") &&
      contains(google_compute_firewall.this["lb-api"].source_ranges, "203.0.113.20/32") &&
      contains(google_compute_firewall.this["lb-ingress"].source_ranges, "0.0.0.0/0") &&
      contains(google_compute_firewall.this["lb-ingress"].source_ranges, "203.0.113.20/32") &&
      google_compute_firewall.this["lb-api"].target_tags == toset(["gcp-test-control-plane"])
    )
    error_message = "The passthrough load balancers keep the client address: api_cidrs, ingress_cidrs and the NAT address are the clients."
  }

  assert {
    condition = (
      contains(google_compute_firewall.this["lb-health"].source_ranges, "35.191.0.0/16") &&
      contains(google_compute_firewall.this["lb-health"].source_ranges, "130.211.0.0/22") &&
      contains(google_compute_firewall.this["lb-health"].source_ranges, "209.85.152.0/22") &&
      contains(google_compute_firewall.this["lb-health"].source_ranges, "209.85.204.0/22") &&
      contains(flatten([for a in google_compute_firewall.this["lb-health"].allow : a.ports]), "8080")
    )
    error_message = "Health checks come from Google's probe ranges, including the Traefik ping port."
  }

  assert {
    condition = (
      toset(flatten([for a in google_compute_firewall.this["control-plane-api"].allow : a.ports])) == toset(["6443", "9345"]) &&
      google_compute_firewall.this["control-plane-api"].source_tags == toset(["gcp-test-control-plane", "gcp-test-agent"]) &&
      toset(flatten([for a in google_compute_firewall.this["control-plane-etcd"].allow : a.ports])) == toset(["2379-2381"]) &&
      toset([for a in google_compute_firewall.this["cluster-nodes"].allow : a.protocol]) == toset(["tcp", "udp", "icmp"])
    )
    error_message = "API and supervisor from nodes, etcd between control planes, node ports between members."
  }
}

