  }

  assert {
    condition = (
      azurerm_linux_virtual_machine.jumphost[0].source_image_reference[0].publisher == "SUSE" &&
      azurerm_linux_virtual_machine.jumphost[0].source_image_reference[0].offer == "sles-16-0-x86-64" &&
