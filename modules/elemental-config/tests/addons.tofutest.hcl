gent\nspec:\n  backoffLimit: 2\n  ttlSecondsAfterFinished: 60\n  template:\n    spec:\n      serviceAccountName: sts-agent-setup-sa\n      restartPolicy: Never\n      containers:\n        - name: generate-token\n          image: \"registry.opensuse.org/home/eminguez/containers/leap16/sts-tools:3.9.2\"\n          command: [\"/bin/bash\", \"-c\"]\n          args:\n            - |\n              set -euo pipefail\n\n              echo \"Waiting for the SUSE Observability API at $${STS_CLI_URL}...\"\n              until curl -s -f -H \"X-API-Key: $${STS_CLI_SERVICE_TOKEN}\" \"$${STS_CLI_URL}/api/server/info\" \u003e /dev/null; do sleep 5; done\n\n              TOKEN=$(kubectl get secret open-telemetry-collector -n open-telemetry -o jsonpath='{.data.API_KEY}' 2\u003e /dev/null | base64 -d || true)\n              if [ -z \"$${TOKEN}\" ]; then\n                SUBJECT=\"k8s-$${CLUSTER}-agent-role\"\n                sts rbac create-subject --subject \"$${SUBJECT}\" || true\n                sts rbac grant --subject \"$${SUBJECT}\" --permission update-scoped-permissions --resource \"$${CLUSTER}\" || true\n                sts rbac grant --subject \"$${SUBJECT}\" --permission update-metrics --resource system || true\n                TOKEN=$(sts service-token create --name \"k8s-$${CLUSTER}-agent-st\" --roles \"$${SUBJECT}\" -o json \\\n                  | jq -r '.\"service-token\".token')\n                if [ -z \"$${TOKEN}\" ] || [ \"$${TOKEN}\" = \"null\" ]; then\n                  echo \"Error: failed to create the service token.\"\n                  exit 1\n                fi\n              fi\n\n              for target in open-telemetry/open-telemetry-collector/API_KEY suse-observability-agent/suse-observability-agent-token/STS_API_KEY; do\n                IFS=/ read -r ns name key \u003c\u003c\u003c \"$${target}\"\n                kubectl create secret generic \"$${name}\" -n \"$${ns}\" --from-literal=\"$${key}=$${TOKEN}\" --dry-run=client -o yaml | kubectl apply -f -\n