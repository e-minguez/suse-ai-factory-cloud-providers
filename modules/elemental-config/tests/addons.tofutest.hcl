\", \"list\", \"watch\"]\n        - apiGroups: [\"apps\"]\n          resources: [\"replicasets\"]\n          verbs: [\"get\", \"list\", \"watch\"]\n    image:\n      registry: \"\"\n      repository: ghcr.io/suse/suse-ai-opentelemetry-collector\n      tag: \"0.156.0\"\n      pullPolicy: IfNotPresent\n    ports:\n      metrics:\n        enabled: true\n    resources:\n      requests:\n        cpu: 256m\n        memory: 512Mi\n      limits:\n        cpu: \"1\"\n        memory: 1Gi\n    useGOMEMLIMIT: true\n    config:\n      extensions:\n        bearertokenauth:\n          scheme: SUSEObservability\n          token: \"$${env:API_KEY}\"\n      receivers:\n        prometheus:\n          config:\n            scrape_configs:\n              - job_name: 'gpu-metrics'\n                scrape_interval: 10s\n                scrape_timeout: 5s\n                kubernetes_sd_configs:\n                  - role: endpointslice\n                    namespaces:\n                      names:\n                        - gpu-operator\n                relabel_configs:\n                  - source_labels: [__meta_kubernetes_endpointslice_port_name]\n                    action: keep\n                    regex: 'gpu-metrics|metrics'\n                metric_relabel_configs: \u0026drop_infra_metrics\n                  - source_labels: [__name__]\n                    regex: '(go|process|promhttp|python)_.*'\n                    action: drop\n              - job_name: 'milvus'\n                scrape_interval: 15s\n                scrape_timeout: 10s\n                metrics_path: '/metrics'\n                static_configs:\n                  - targets: ['milvus.$${env:SUSE_AI_NAMESPACE}.svc.cluster.local:9091']\n                metric_relabel_configs: *drop_infra_metrics\n              - job_name: 'qdrant'\n                scrape_interval: 10s\n                scrape_timeout: 5s\n                metrics_path: '/metrics'\n                static_configs:\n                  - targets: ['qdrant.$${env:SUSE_AI_NAMESPACE}.svc.cluster.local:6333']\n                metric_relabel_configs: *drop_infra_metrics\n              - job_name: 'vllm'\n                scrape_interval: 10s\n                scrape_timeout: 5s\n                kubernetes_sd_configs:\n                  - role: endpointslice\n                relabel_configs:\n                  - source_labels: [__meta_kubernetes_namespace]\n                    action: keep\n                    regex: '$${env:SUSE_AI_NAMESPACE}'\n                  - source_labels: [__meta_kubernetes_service_name]\n                    action: keep\n                    regex: '.*vllm.*'\n                  - source_labels: [__meta_kubernetes_endpointslice_port_name]\n                    action: drop\n                    regex: '.*(zmq|ucx|lmcache).*'\n                metric_relabel_configs: *drop_infra_metrics\n      exporters:\n        topology:\n          endpoint: \"http://suse-observability-router.suse-observability.svc.cluster.local:8080\"\n          api_key: $${env:API_KEY}\n          namespace: \"\"\n          cluster_name: $${env:K8S_CLUSTER_NAME}\n        otlp_http/suse-observability:\n          endpoint: \"http://suse-observability-otel-collector.suse-observability.svc.cluster.local:4318\"\n          auth:\n            authenticator: bearertokenauth\n          sending_queue:\n            queue_size: 5000\n      processors:\n        memory_limiter:\n          check_interval: 1s\n          limit_percentage: 80\n          spike_limit_percentage: 20\n        k8s_attributes:\n          extract:\n            metadata:\n              - k8s.namespace.name\n              - k8s.pod.name\n              - k8s.pod.uid\n              - k8s.node.name\n              - k8s.pod.start_time\n              - k8s.deployment.name\n              - k8s.replicaset.name\n              - k8s.daemonset.name\n              - k8s.job.name\n              - k8s.container.name\n              - k8s.cronjob.name\n              - k8s.statefulset.name\n              - container.image.tag\n              - container.image.name\n              - service.namespace\n              - service.name\n              - service.version\n              - service.instance.id\n            labels:\n              - tag_name: $$1\n                key_regex: (.*)\n                from: pod\n            otel_annotations: true\n          pod_association:\n            - sources:\n                - from: resource_attribute\n                  name: k8s.pod.ip\n            - sources:\n                - from: resource_attribute\n                  name: k8s.pod.uid\n            - sources:\n                - from: connection\n        batch: {}\n        resource:\n          attributes:\n          - key: k8s.cluster.name\n            action: upsert\n            value: $${env:K8S_CLUSTER_NAME}\n          - key: service.instance.id\n            from_attribute: k8s.pod.uid\n            action: insert\n        transform/vllm-metric-names:\n          error_mode: ignore\n          metric_statements:\n            - context: metric\n              statements:\n                - replace_pattern(name, \"^vllm:\", \"vllm_\")\n                - set(name, \"vllm_gpu_cache_usage_perc\") where name == \"vllm_kv_cache_usage_perc\"\n        transform/genai-metric-names:\n          error_mode: ignore\n          metric_statements:\n            - context: metric\n              statements:\n                - set(name, \"gen_ai.client.operation.cost\") where name == \"gen_ai.usage.cost\"\n        transform/vllm:\n          error_mode: ignore\n          metric_statements:\n            - context: resource\n              statements:\n                - set(attributes[\"suse.ai.managed\"], \"true\") where attributes[\"service.name\"] == \"vllm\"\n                - set(attributes[\"suse.ai.component.name\"], \"vllm\") where attributes[\"service.name\"] == \"vllm\"\n                - set(attributes[\"suse.ai.component.type\"], \"inference-engine\") where attributes[\"service.name\"] =