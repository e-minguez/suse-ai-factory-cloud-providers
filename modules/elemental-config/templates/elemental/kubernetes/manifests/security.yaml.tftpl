---
apiVersion: v1
kind: Namespace
metadata:
  name: cattle-neuvector-system
  labels:
    # The enforcer inspects host processes and network traffic.
    pod-security.kubernetes.io/enforce: privileged
%{ if role == "management" }
---
# TLS material is generated by Terraform; no cert-manager objects.
apiVersion: v1
kind: Secret
metadata:
  name: suse-security-ca
  namespace: cattle-neuvector-system
type: Opaque
stringData:
  ca.crt: |
    ${indent(4, chomp(ca_pem))}
---
apiVersion: v1
kind: Secret
metadata:
  name: suse-security-manager-tls
  namespace: cattle-neuvector-system
type: kubernetes.io/tls
stringData:
  tls.crt: |
    ${indent(4, chomp(manager_tls_cert_pem))}
  tls.key: |
    ${indent(4, chomp(manager_tls_key_pem))}
---
# Certificate served by the Manager pod itself (manager.certificate.secret).
apiVersion: v1
kind: Secret
metadata:
  name: neuvector-manager-backend-tls
  namespace: cattle-neuvector-system
type: kubernetes.io/tls
stringData:
  tls.crt: |
    ${indent(4, chomp(backend_cert_pem))}
  tls.key: |
    ${indent(4, chomp(backend_key_pem))}
%{ endif }
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: neuvector-crd
  namespace: kube-system
spec:
  repo: https://charts.rancher.io/
  chart: neuvector-crd
  version: ${jsonencode(chart_version)}
  targetNamespace: cattle-neuvector-system
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: neuvector
  namespace: kube-system
spec:
  repo: https://charts.rancher.io/
  chart: neuvector
  version: ${jsonencode(chart_version)}
  targetNamespace: cattle-neuvector-system
  valuesContent: |-
%{ if role == "management" }
    # Traefik backend annotations + ServersTransport: HTTPS to the Manager,
    # verified against the Terraform-generated CA.
    ingressController: traefik
    traefik:
      serversTransport:
        insecureSkipVerify: false
        serverName: neuvector-service-webui.cattle-neuvector-system.svc
        rootCAsSecrets:
          - suse-security-ca
%{ endif }
    global:
      cattle:
%{ if rancher_url != "" }
        url: ${jsonencode(rancher_url)}
        # Sets RANCHER_CLUSTER_NAME: without it the controller detects Rancher only
        # if cattle-system exists at its start, which races the Rancher install.
        clusterName: ${jsonencode(rancher_cluster_name)}
%{ endif }
        systemDefaultRegistry: registry.rancher.com
    controller:
      prime:
        enabled: true
%{ if rancher_url == "" }
      ranchersso:
        enabled: false
%{ endif }
      # REST API (10443) used by the security-fed-* jobs.
      apisvc:
        type: ClusterIP
      federation:
%{ if role == "management" }
        mastersvc:
          type: ClusterIP
%{ else }
        managedsvc:
          type: ClusterIP
%{ endif }
      configmap:
        enabled: true
        data:
          fedinitcfg.yaml: |-
            always_reload: true
            Cluster_Name: ${jsonencode(cluster_name)}
            Join_Token: ${jsonencode(join_token)}
            Primary_Rest_Info:
              Server: ${jsonencode(primary_server)}
              Port: ${primary_port}
%{ if role == "downstream" }
            Managed_Rest_Info:
              Server: ${jsonencode(federation_hostname)}
              Port: 443
%{ endif }
      # Secret "neuvector-init" wins over the ConfigMap of the same name.
      # Management: always_reload re-gives admin the fedAdmin role after the
      # promotion; downstream keeps UI password changes.
      secret:
        enabled: true
        data:
          userinitcfg.yaml:
%{ if role == "management" }
            always_reload: true
%{ endif }
            users:
              - Fullname: admin
                Password: ${jsonencode(admin_password)}
%{ if role == "management" }
                # fedAdmin directly: re-applied after the promotion, it cannot be
                # reset to admin (the reset otherwise needs a controller restart).
                Role: fedAdmin
%{ else }
                Role: admin
%{ endif }
    manager:
%{ if role == "management" }
      certificate:
        secret: neuvector-manager-backend-tls
        keyFile: tls.key
        pemFile: tls.crt
      svc:
        type: ClusterIP
      ingress:
        enabled: true
        ingressClassName: traefik
        host: ${jsonencode(manager_hostname)}
        path: /
        annotations:
          traefik.ingress.kubernetes.io/router.entrypoints: websecure
        tls: true
        secretName: suse-security-manager-tls
%{ else }
      # The Rancher UI extension reaches the Manager through the Rancher proxy.
      svc:
        type: ClusterIP
%{ endif }
---
# Federation endpoint: TLS passthrough on websecure, selected by SNI. Applied
# by the security-fed-* jobs: Elemental applies image manifests once, possibly
# before the Traefik CRDs exist.
apiVersion: v1
kind: ConfigMap
metadata:
  name: security-fed-route
  namespace: cattle-neuvector-system
data:
  route.yaml: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRouteTCP
    metadata:
      name: neuvector-federation
      namespace: cattle-neuvector-system
      annotations:
        # RKE2 Traefik runs with providers.kubernetescrd.ingressClass=traefik
        # and ignores CRD objects without this class.
        kubernetes.io/ingress.class: traefik
    spec:
      entryPoints:
        - websecure
      routes:
        - match: ${jsonencode("HostSNI(`${federation_hostname}`)")}
          services:
%{ if role == "management" }
            - name: neuvector-svc-controller-fed-master
              port: 11443
%{ else }
            - name: neuvector-svc-controller-fed-managed
              port: 10443
%{ endif }
      tls:
        passthrough: true
---
apiVersion: v1
kind: Secret
metadata:
  name: security-fed-watch
  namespace: cattle-neuvector-system
type: Opaque
data:
  ADMIN_PASSWORD: ${base64encode(admin_password)}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: security-fed-watch
  namespace: cattle-neuvector-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: security-fed-watch
  namespace: cattle-neuvector-system
rules:
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: ["security-fed-route"]
    verbs: ["get", "patch"]
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "delete", "deletecollection"]
  - apiGroups: ["traefik.io"]
    resources: ["ingressroutetcps"]
    verbs: ["get", "create", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: security-fed-watch
  namespace: cattle-neuvector-system
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: security-fed-watch
subjects:
  - kind: ServiceAccount
    name: security-fed-watch
    namespace: cattle-neuvector-system
%{ if role == "management" }
---
# Applies the federation route and reports the primary state. It never
# restarts controllers: a rolling restart drops the fixed join token, a full
# one re-runs the promotion. Fails when admin is not fedAdmin after 10 minutes.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: security-fed-init
  namespace: cattle-neuvector-system
spec:
  schedule: "*/5 * * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 1
  jobTemplate:
    spec:
      backoffLimit: 0
      template:
        spec:
          serviceAccountName: security-fed-watch
          restartPolicy: Never
          volumes:
            - name: route
              configMap:
                name: security-fed-route
          containers:
            - name: init
              image: ${jsonencode(tools_image)}
              envFrom:
                - secretRef:
                    name: security-fed-watch
              volumeMounts:
                - name: route
                  mountPath: /etc/security-fed-route
                  readOnly: true
              command: ["/bin/bash", "-c"]
              args:
                - |
                  set -euo pipefail
                  API=https://neuvector-svc-controller-api.cattle-neuvector-system:10443
                  NS=cattle-neuvector-system
                  token=""

                  logout() {
                    if [ -n "$token" ]; then
                      curl -sk --max-time 20 -X DELETE -H "X-Auth-Token: $token" "$API/v1/auth" >/dev/null || true
                    fi
                  }
                  trap logout EXIT

                  kubectl apply -f /etc/security-fed-route/route.yaml ||
                    echo "federation route not applied yet (Traefik CRDs missing?)"

                  token=$(jq -n --arg p "$ADMIN_PASSWORD" \
                    '{password: {username: "admin", password: $p}}' |
                    curl -sk --max-time 20 -H 'Content-Type: application/json' \
                      -d @- "$API/v1/auth" | jq -er '.token.token') || {
                    token=""
                    echo "login failed, controller not ready; retry next run"
                    exit 0
                  }
                  fed_role=$(curl -sk --max-time 20 -H "X-Auth-Token: $token" "$API/v1/fed/member" | jq -r '.fed_role // ""') || fed_role=""
                  role=$(curl -sk --max-time 20 -H "X-Auth-Token: $token" "$API/v1/user/admin" | jq -r '.user.role // ""') || role=""
                  echo "fed_role=$fed_role admin_role=$role"

                  if [ "$fed_role" = "master" ] && [ "$role" = "fedAdmin" ]; then
                    echo "primary ready, admin is fedAdmin"
                    exit 0
                  fi
                  oldest=$(kubectl -n "$NS" get pods -l app=neuvector-controller-pod -o json |
                    jq -r '[.items[].metadata.creationTimestamp | fromdateiso8601] | min // empty')
                  age=$(( $(date +%s) - $${oldest:-$(date +%s)} ))
                  if [ "$age" -gt 600 ]; then
                    echo "ERROR: fed_role='$fed_role' admin_role='$role' $${age}s after the controllers started" >&2
                    exit 1
                  fi
                  echo "primary not ready yet, oldest controller is $${age}s old; waiting"
%{ else }
---
# Re-triggers the join: NeuVector applies fedinitcfg only when all controllers
# start as a new cluster, so it deletes them all at once (a rolling restart does
# not re-send it). Capped (annotation on security-fed-route); then Failed.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: security-fed-join
  namespace: cattle-neuvector-system
spec:
  schedule: "*/5 * * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 1
  jobTemplate:
    spec:
      backoffLimit: 0
      template:
        spec:
          serviceAccountName: security-fed-watch
          restartPolicy: Never
          volumes:
            - name: route
              configMap:
                name: security-fed-route
          containers:
            - name: join
              image: ${jsonencode(tools_image)}
              envFrom:
                - secretRef:
                    name: security-fed-watch
              volumeMounts:
                - name: route
                  mountPath: /etc/security-fed-route
                  readOnly: true
              command: ["/bin/bash", "-c"]
              args:
                - |
                  set -euo pipefail
                  API=https://neuvector-svc-controller-api.cattle-neuvector-system:10443
                  NS=cattle-neuvector-system
                  CM=security-fed-route
                  KEY=suse-security/restarts
                  MAX=6
                  token=""

                  logout() {
                    if [ -n "$token" ]; then
                      curl -sk --max-time 20 -X DELETE -H "X-Auth-Token: $token" "$API/v1/auth" >/dev/null || true
                    fi
                  }
                  trap logout EXIT

                  get_count() {
                    kubectl -n "$NS" get cm "$CM" -o json | jq -r --arg k "$KEY" '.metadata.annotations[$k] // "0"' || echo 0
                  }
                  set_count() {
                    kubectl -n "$NS" annotate cm "$CM" --overwrite "$KEY=$1" "suse-security/restarted-at=$(date -u +%Y%m%d-%H%M%S)" >/dev/null
                  }

                  kubectl apply -f /etc/security-fed-route/route.yaml ||
                    echo "federation route not applied yet (Traefik CRDs missing?)"

                  token=$(jq -n --arg p "$ADMIN_PASSWORD" \
                    '{password: {username: "admin", password: $p}}' |
                    curl -sk --max-time 20 -H 'Content-Type: application/json' \
                      -d @- "$API/v1/auth" | jq -er '.token.token') || {
                    token=""
                    echo "login failed, controller not ready; retry next run"
                    exit 0
                  }
                  member=$(curl -sk --max-time 20 -H "X-Auth-Token: $token" "$API/v1/fed/member") || member="{}"
                  fed_role=$(jq -r '.fed_role // ""' <<<"$member" 2>/dev/null) || fed_role=""
                  # "kicked": the primary forgot this cluster (e.g. a full restart
                  # without persistence), so it must join again.
                  self_status=$(jq -r '.joint_clusters[0].status // ""' <<<"$member" 2>/dev/null) || self_status=""
                  echo "fed_role=$fed_role status=$self_status"
                  count=$(get_count)
                  if [ "$fed_role" = "joint" ] && [ "$self_status" != "kicked" ]; then
                    echo "joined to the primary"
                    if [ "$count" != "0" ]; then set_count 0 || true; fi
                    exit 0
                  fi
                  if [ "$count" -ge "$MAX" ]; then
                    echo "ERROR: not joined after $MAX controller restarts" >&2
                    exit 1
                  fi

                  oldest=$(kubectl -n "$NS" get pods -l app=neuvector-controller-pod -o json |
                    jq -r '[.items[].metadata.creationTimestamp | fromdateiso8601] | min // empty')
                  if [ -z "$oldest" ]; then
                    echo "no controller pod found"
                    exit 0
                  fi
                  age=$(( $(date +%s) - oldest ))
                  if [ "$age" -gt 600 ]; then
                    echo "not joined and oldest controller is $${age}s old: restarting all controllers ($((count + 1))/$MAX)"
                    set_count $((count + 1))
                    kubectl -n "$NS" delete pods -l app=neuvector-controller-pod --wait=false
                  else
                    echo "not joined yet, oldest controller is $${age}s old; waiting"
                  fi
%{ endif }
