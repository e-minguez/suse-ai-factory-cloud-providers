#!/usr/bin/env bash
# Pins the RKE2 node-ip to the IPv4 address inside ${vpc_cidr}: on multi-NIC
# nodes always; on single-NIC nodes only with PIN_SINGLE_NIC (the platform's
# DHCP can hand out an address outside the VPC range first).
set -euo pipefail

VPC_CIDR="${vpc_cidr}"
PIN_SINGLE_NIC="${pin_single_nic}"
CONFIG_DIR="/etc/rancher/rke2/config.yaml.d"

log() { echo "[write-node-ip] $*"; }

nics=()
for dev in /sys/class/net/*/device; do
  [ -e "$dev" ] || continue
  dev=$${dev%/device}
  nics+=("$${dev##*/}")
done

# 2 s per try: 1 minute for multi-NIC nodes, 10 minutes when pinning a single NIC.
tries=30
if [ "$${#nics[@]}" -le 1 ]; then
  if [ "$PIN_SINGLE_NIC" != "true" ]; then
    log "found $${#nics[@]} NIC(s); nothing to do"
    exit 0
  fi
  tries=300
fi

ip_to_int() {
  local IFS=. a b c d
  read -r a b c d <<<"$1"
  echo $(( (a << 24) | (b << 16) | (c << 8) | d ))
}

bits=$${VPC_CIDR#*/}
mask=$(( bits == 0 ? 0 : (0xFFFFFFFF << (32 - bits)) & 0xFFFFFFFF ))
net=$(( $(ip_to_int "$${VPC_CIDR%/*}") & mask ))

node_ip=""
for _ in $(seq 1 "$tries"); do
  while read -r line; do
    rest=$${line#*inet }
    [ "$rest" = "$line" ] && continue
    addr=$${rest%% *}
    addr=$${addr%%/*}
    if [ $(( $(ip_to_int "$addr") & mask )) -eq "$net" ]; then
      node_ip=$addr
      break
    fi
  done < <(ip -4 -o addr show scope global 2>/dev/null)
  [ -n "$node_ip" ] && break
  sleep 2
done

if [ -z "$node_ip" ]; then
  log "ERROR: no IPv4 address inside $VPC_CIDR after $((tries * 2))s"
  exit 1
fi

mkdir -p "$CONFIG_DIR"
printf 'node-ip: %s\n' "$node_ip" >"$CONFIG_DIR/99-node-ip.yaml"
log "wrote $CONFIG_DIR/99-node-ip.yaml: node-ip: $node_ip"
