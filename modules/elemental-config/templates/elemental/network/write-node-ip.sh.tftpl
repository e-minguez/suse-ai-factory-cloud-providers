#!/usr/bin/env bash
# Pins the RKE2 node-ip on multi-NIC nodes to the IPv4 address inside
# ${vpc_cidr}. Single-NIC nodes keep RKE2's default and nothing is written.
set -euo pipefail

VPC_CIDR="${vpc_cidr}"
CONFIG_DIR="/etc/rancher/rke2/config.yaml.d"

log() { echo "[write-node-ip] $*"; }

nics=()
for dev in /sys/class/net/*/device; do
  [ -e "$dev" ] || continue
  dev=$${dev%/device}
  nics+=("$${dev##*/}")
done

if [ "$${#nics[@]}" -le 1 ]; then
  log "found $${#nics[@]} NIC(s); nothing to do"
  exit 0
fi

ip_to_int() {
  local IFS=. a b c d
  read -r a b c d <<<"$1"
  echo $(( (a << 24) | (b << 16) | (c << 8) | d ))
}

bits=$${VPC_CIDR#*/}
mask=$(( bits == 0 ? 0 : (0xFFFFFFFF << (32 - bits)) & 0xFFFFFFFF ))
net=$(( $(ip_to_int "$${VPC_CIDR%/*}") & mask ))

node_ip=""
for _ in $(seq 1 30); do
  while read -r line; do
    rest=$${line#*inet }
    [ "$rest" = "$line" ] && continue
    addr=$${rest%% *}
    addr=$${addr%%/*}
    if [ $(( $(ip_to_int "$addr") & mask )) -eq "$net" ]; then
      node_ip=$addr
      break
    fi
  done < <(ip -4 -o addr show scope global 2>/dev/null)
  [ -n "$node_ip" ] && break
  sleep 2
done

if [ -z "$node_ip" ]; then
  log "ERROR: no IPv4 address inside $VPC_CIDR after 60s"
  exit 1
fi

mkdir -p "$CONFIG_DIR"
printf 'node-ip: %s\n' "$node_ip" >"$CONFIG_DIR/99-node-ip.yaml"
log "wrote $CONFIG_DIR/99-node-ip.yaml: node-ip: $node_ip"
