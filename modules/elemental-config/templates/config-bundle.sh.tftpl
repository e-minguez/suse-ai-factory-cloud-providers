#!/bin/bash
# Self-extracting elemental config bundle: $1 is the target config dir.
# Heredocs are quoted, so file contents are written verbatim.
set -euo pipefail
umask 077
dir=$${1:?usage: $0 <config-dir>}
%{ for path, content in files ~}
mkdir -p "$(dirname "$dir/${path}")"
cat > "$dir/${path}" <<'${delimiter}'
${content}${delimiter}
chmod ${endswith(path, ".sh") ? "0755" : "0600"} "$dir/${path}"
%{ endfor ~}
