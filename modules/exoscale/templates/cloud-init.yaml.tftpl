#cloud-config
disable_root: false
ssh_authorized_keys:
%{ for key in ssh_authorized_keys ~}
  - ${key}
%{ endfor ~}
%{ if jumphost_username != "" ~}

users:
  - default
  - name: ${jumphost_username}
    shell: /bin/bash
    lock_passwd: true
    sudo: 'ALL=(ALL) NOPASSWD:ALL'
    ssh_authorized_keys:
%{ for key in ssh_authorized_keys ~}
      - ${key}
%{ endfor ~}
%{ endif ~}

write_files:
%{ for path, content in files ~}
  - path: ${config_dir}/${path}
    encoding: gz+b64
    content: ${base64gzip(content)}
    owner: root:root
    permissions: '${endswith(path, ".sh") ? "0755" : "0600"}'
%{ endfor ~}
  - path: /opt/image-factory.sh
    encoding: gz+b64
    content: ${base64gzip(factory_script)}
    owner: root:root
    permissions: '0700'

runcmd:
  - 'nohup setsid /opt/image-factory.sh </dev/null >/dev/null 2>&1 &'
