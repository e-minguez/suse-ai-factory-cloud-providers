# Generated by scripts/tests/tofu-tests.sh --write from catalog.tftest.hcl. Do not edit: change the
# Terraform suite and regenerate (make tofu-tests-gen). OpenTofu reads this file instead of it.
# Plans examples/aws with one catalog tfvars file (make test-catalog passes it
# with -var-file), so a validation or precondition change that breaks a shape
# fails CI. AWS mocked; no cloud calls. Credentials below stand in for
# clusters/common-*.tfvars; the CA stands in for addons.auto.tfvars.json.

mock_provider "aws" {
}
mock_provider "aws" {
  alias = "nodes"
}
mock_provider "http" {}

override_data {
  target = module.ai_factory.module.elemental_config.data.http.aif_release_manifest
  values = {
    status_code   = 200
    response_body = "metadata:\n  name: suse-ai-factory\n  # Comment lines are dropped when the manifest is rewritten.\n  version: 2.4.0\ncorePlatform:\n  image: registry.suse.com/elemental/rke2/rke2-manifest:1.35.6-48.1\ncomponents:\n  systemd:\n    extensions:\n      - name: \"suse-storage\"\n        image: \"registry.suse.com/elemental/longhorn:4.111-4.79\"\n  helm:\n    charts:\n      - chart: \"cert-manager\"\n        version: \"v1.21.0\"\n        namespace: \"cert-manager\"\n        repository: \"jetstack\"\n      - chart: \"rancher\"\n        version: \"2.14.3\"\n        namespace: \"cattle-system\"\n        repository: \"rancher-prime\"\n        dependsOn:\n          - name: \"cert-manager\"\n            type: \"helm\"\n        values:\n          replicas: 1\n          global:\n            psp:\n              enabled: \"false\"\n"
  }
}

