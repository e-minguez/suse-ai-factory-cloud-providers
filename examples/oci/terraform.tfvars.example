# Per-cluster values. Loaded last, so it wins over ../../common-all.tfvars and
# ../common-oci.tfvars (deploy.sh layers them, later wins). Values every
# provider declares (admin_cidrs, password hashes, ssh_authorized_keys,
# registry credentials, aif_release) can live in common-all.tfvars instead;
# the oci_* credentials and region fit common-oci.tfvars.

# false builds the network, load balancer address and image only.
# deploy_nodes = true

# Region the tenancy is subscribed to. eu-frankfurt-1 offers VM.GPU.A10.1/2.
region = "eu-frankfurt-1"

# API-key authentication (Identity, My profile, API keys).
oci_tenancy_ocid     = "ocid1.tenancy.oc1..REPLACE"
oci_user_ocid        = "ocid1.user.oc1..REPLACE"
oci_fingerprint      = "aa:bb:cc:REPLACE"
oci_private_key_path = "~/.oci/REPLACE.pem"
oci_compartment_ocid = "ocid1.compartment.oc1..REPLACE"

# CIDRs allowed to SSH into the jumphost, the only SSH entry: your admin IP(s)
# or VPN range.
admin_cidrs = ["REPLACE_WITH_YOUR_IP/32"]

# Generate both with `openssl passwd -6`. They must differ.
root_password_hash      = "REPLACE_WITH_OUTPUT_OF_openssl_passwd_-6"
node_user_password_hash = "REPLACE_WITH_A_DIFFERENT_OUTPUT_OF_openssl_passwd_-6"

# At least one public key, installed for node_username and on the jumphost.
ssh_authorized_keys = ["REPLACE_WITH_YOUR_ssh-ed25519_OR_ssh-rsa_PUBLIC_KEY"]

# Login on the nodes; escalate with `su -` (no sudo in the image).
# node_username = "suse"

# --- Registry credentials -------------------------------------------------

# Application Collection is required with local-path-provisioner (in the
# default components) or suse-storage; the SUSE registry and NVIDIA NGC ones
# are optional. With aif-operator, set all of them.
appco_username         = "REPLACE_WITH_YOUR_APPLICATION_COLLECTION_USERNAME"
appco_password         = "REPLACE_WITH_YOUR_APPLICATION_COLLECTION_PASSWORD"
suse_registry_username = "REPLACE_WITH_YOUR_SUSE_REGISTRY_USERNAME"
suse_registry_password = "REPLACE_WITH_YOUR_SUSE_REGISTRY_PASSWORD"
nvidia_api_key         = "REPLACE_WITH_YOUR_NVIDIA_NGC_API_KEY"

# --- Shapes ---------------------------------------------------------------
# Fixed shapes are a plain name ("VM.GPU.A10.1"). Flex shapes take a size,
# "<shape>:<ocpus>x<memory_gb>"; a flex shape without it fails the plan.
# VM GPU shapes only: bare metal shapes cannot boot the imported image.
#
gpu_pools = {
  gpu = { instance_type = "VM.GPU.A10.1", count = 1 }
}
# worker_pools = {
#   wrk = { instance_type = "VM.Standard.E5.Flex:8x64", count = 2 }
# }

# --- Optional -------------------------------------------------------------

# AI Factory: a version X.Y.Z (tag aif-operator-<version>, 2.1.0 or newer) or
# a manifest URL (branch, fork or mirror).
# aif_release = "2.4.0"

# Changing components rebuilds the image and replaces every node.
# components = ["rancher", "gpu-operator", "local-path-provisioner", "aif-operator"]

# rancher_hostname = null  # defaults to "rancher-<reserved IP>.sslip.io"
# ingress_domain   = "aif.example.com"
# api_cidrs        = ["0.0.0.0/0"]  # who may reach the Kubernetes API on 6443
# ingress_cidrs    = ["0.0.0.0/0"]  # who may reach the ingress on 80/443

# zones                       = ["ad-1"]  # lowercase availability domain names
# cluster_name                = "suse-ai-factory"
# control_plane_count         = 3  # 1, or odd and at least 3
# control_plane_instance_type = "VM.Standard.E5.Flex:4x32"
# jumphost_instance_type      = "VM.Standard.E5.Flex:2x16"
# jumphost_image              = "ocid1.image.oc1..."  # default: newest Oracle Linux 9
# keep_build_artifacts        = false
# tags replaces (not merges with) any tags map in common-*.tfvars.
# tags                        = { env = "test" }
# image_id                    = "ocid1.image.oc1..."  # boot an existing image instead of building

# Deploy into an existing VCN instead of creating one: a regional public subnet
# (public IPs allowed, 0.0.0.0/0 to an internet gateway) and a regional private
# subnet (0.0.0.0/0 to a NAT gateway). All three or none; route tables and the
# NAT gateway must be in the VCN compartment. Destroy leaves them in place.
# See docs/providers/oci.md#existing-network.
# vpc_id            = "ocid1.vcn.oc1..."
# public_subnet_id  = "ocid1.subnet.oc1..."
# private_subnet_id = "ocid1.subnet.oc1..."
