# --------------------------------------------------------------------------
# Secrets and operator-filled variable files. Every *.tfvars is ignored
# (common-all, common-<provider>, per-cluster, deploy.sh's pass2.auto.*);
# only *.tfvars.example templates are committed. Real files can carry
# credentials (SCC/registry passwords, SSH keys, password hashes, API keys).
# --------------------------------------------------------------------------
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
# Fabricated test fixtures of tools/cost.
!tools/cost/**/testdata/*.tfvars

# evroc CLI credentials (normally ~/.evroc/, kept out if ever copied here).
.evroc/
evroc-config.yaml

kubeconfig*
*.kubeconfig
!scripts/kubeconfig.sh
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

.terraformrc
terraform.rc
.env
.envrc

# Local-only Terraform overrides; the natural place to stash a real value
# "just for now".
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --------------------------------------------------------------------------
# State and plans. Terraform state carries every sensitive input in
# plaintext (see docs/security.md) -- match broadly, not by exact filename.
# --------------------------------------------------------------------------
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
*.tfplan.*
crash.log
crash.*.log

# --------------------------------------------------------------------------
# Working directories and generated artefacts.
# --------------------------------------------------------------------------
.terraform/
modules/**/.terraform.lock.hcl
examples/**/.terraform.lock.hcl

# tools/multicluster working area (tools/multicluster/README.md): symlinked
# cluster roots and tfvars, generated by cluster.sh, not source.
/clusters/
tools/**/.terraform.lock.hcl

# deploy.sh's plan/apply logs (docs/conventions.md#deploy-script); they can
# hold secrets in plaintext.
.deploy/

# Built elemental images: several GB, and hold the RKE2 join token and
# root's password hash if ever built locally instead of on a build host.
*.raw
*.iso
*.qcow2

# tools/cost built binary (phase 3).
tools/cost/cost

# --------------------------------------------------------------------------
# Editor, tooling and OS noise.
# --------------------------------------------------------------------------
.claude/
.DS_Store
*.swp
*~
*.bak
*.orig
